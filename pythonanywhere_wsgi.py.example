"""Configuração WSGI do Portal CCO para a conta PythonAnywhere CCOFields."""

import json
import os
import sys
from pathlib import Path

PROJECT_ROOT = Path("/home/CCOFields/safe-central-cco")
SECRETS_PATH = Path("/home/CCOFields/.portalcco-secrets.json")
DATA_ROOT = Path("/home/CCOFields/portalcco-data")
KNOWLEDGE_ROOT = Path("/home/CCOFields/portalcco-knowledge")

sys.path.insert(0, str(PROJECT_ROOT))

from backend.knowledge_bundle import install_knowledge_bundle  # noqa: E402

secrets = json.loads(SECRETS_PATH.read_text(encoding="utf-8"))
install_knowledge_bundle(
    DATA_ROOT / "knowledge-bundle.zip",
    KNOWLEDGE_ROOT,
    DATA_ROOT / ".knowledge-bundle.sha256",
)
os.environ["SAFE_KNOWLEDGE_ROOT"] = str(KNOWLEDGE_ROOT)
os.environ["SAFE_CCO_DATA_DIR"] = str(DATA_ROOT)
os.environ["SAFE_PORTAL_DB_PATH"] = str(DATA_ROOT / "portalcco.db")
os.environ["SAFE_LEARNING_GRAPH_PATH"] = str(KNOWLEDGE_ROOT / "Knowledge" / "query_graph.json")
os.environ["SAFE_RULES_CATALOG_PATH"] = str(KNOWLEDGE_ROOT / "Regras" / "catalogo_regras.json")
os.environ["SAFE_CCO_SECURE_COOKIES"] = "true"
os.environ["SAFE_CCO_REQUIRE_SETUP_TOKEN"] = "true"
os.environ["SAFE_CCO_SETUP_TOKEN"] = secrets["SAFE_CCO_SETUP_TOKEN"]

for setting in (
    "GEMINI_API_KEY",
    "GEMINI_LOCAL_MODEL",
    "GEMINI_FALLBACK_MODEL",
    "GEMINI_EXTERNAL_MODEL",
):
    if secrets.get(setting):
        os.environ[setting] = secrets[setting]

from backend.wsgi import application  # noqa: E402,F401
